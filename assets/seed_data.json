import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:intl/intl.dart';
import 'database_helper.dart';

class NewOrderScreen extends StatefulWidget {
  @override
  _NewOrderScreenState createState() => _NewOrderScreenState();
}

class _NewOrderScreenState extends State<NewOrderScreen> {
  final TextEditingController _orderNoController = TextEditingController();

  List<String> _suppliers = [];
  List<String> _branches = [];
  List<String> _departments = [];
  List<String> _editors = [];
  List<String> _directors = [];

  String? _selectedSupplier;
  String? _selectedBranch;
  String? _selectedDepartment;
  String? _selectedEditor;
  String? _selectedDirector;

  DateTime _selectedDate = DateTime.now();
  List> _orderItems = [];
  bool _isLoadingDefinitions = true;

  @override
  void initState() {
    super.initState();
    _orderNoController.text = (1000 + DateTime.now().minute * 10 + DateTime.now().second).toString();
    _loadDefinitions();
  }

  Future<void> _loadDefinitions() async {
    try {
      final String jsonString = await rootBundle.loadString('assets/seed_data.json');
      final Map<String, dynamic> data = jsonDecode(jsonString);
      final Map<String, dynamic> definitions = data['definitions'] ?? {};

      List<String> parseList(dynamic rawList) {
        if (rawList is List) {
          return rawList.map((e) => e.toString().trim()).where((s) => s.isNotEmpty).toList();
        }
        return [];
      }

      final suppliers = parseList(definitions['الموردين_Suppliers']);
      final branches = parseList(definitions['الفروع_Branches']);
      final departments = parseList(definitions['المستودعات_الأقسام_Departments']);
      final editors = parseList(definitions['محررو_الطلبات_Editors']);
      final directors = parseList(definitions['المدراء_المسؤولون_Directors']);

      setState(() {
        _suppliers = suppliers;
        _branches = branches;
        _departments = departments;
        _editors = editors;
        _directors = directors;

        if (_suppliers.isNotEmpty) _selectedSupplier = _suppliers.first;
        if (_branches.isNotEmpty) _selectedBranch = _branches.first;
        if (_departments.isNotEmpty) _selectedDepartment = _departments.first;
        if (_editors.isNotEmpty) _selectedEditor = _editors.first;
        if (_directors.isNotEmpty) _selectedDirector = _directors.first;

        _isLoadingDefinitions = false;
      });
    } catch (e) {
      setState(() => _isLoadingDefinitions = false);
    }
  }

  double get _totalAmount {
    return _orderItems.fold(0.0, (double sum, item) {
      final val = item['total'];
      final num parsed = val is num ? val : (num.tryParse(val.toString()) ?? 0.0);
      return sum + parsed.toDouble();
    });
  }

  void _addItemDialog() async {
    List> allItems = await DatabaseHelper.instance.searchItems('');
    List> itemsList = _selectedSupplier == null
        ? allItems
        : allItems.where((i) => i['supplier'] == _selectedSupplier).toList();

    if (itemsList.isEmpty) {
      itemsList = allItems;
    }

    Map<String, dynamic>? selectedItem;
    final qtyController = TextEditingController(text: '1');
    final priceController = TextEditingController();

    showDialog(
      context: context,
      builder: (ctx) => StatefulBuilder(
        builder: (context, setDialogState) => AlertDialog(
          title: Text('إضافة صنف للطلب', textAlign: TextAlign.right),
          content: SingleChildScrollView(
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                DropdownButtonFormField>(
                  isExpanded: true,
                  decoration: InputDecoration(labelText: 'اختر الصنف'),
                  items: itemsList.map((item) {
                    return DropdownMenuItem(
                      value: item,
                      child: Text("${item['item_code']} - ${item['description']}",
                          style: TextStyle(fontSize: 12), overflow: TextOverflow.ellipsis),
                    );
                  }).toList(),
                  onChanged: (val) {
                    setDialogState(() {
                      selectedItem = val;
                      priceController.text = (val?['unit_price'] ?? 0.0).toString();
                    });
                  },
                ),
                SizedBox(height: 10),
                TextField(
                  controller: qtyController,
                  decoration: InputDecoration(labelText: 'الكمية المطلوبة'),
                  keyboardType: TextInputType.numberWithOptions(decimal: true),
                ),
                SizedBox(height: 10),
                TextField(
                  controller: priceController,
                  decoration: InputDecoration(labelText: 'سعر الوحدة'),
                  keyboardType: TextInputType.numberWithOptions(decimal: true),
                ),
              ],
            ),
          ),
          actions: [
            TextButton(
              onPressed: () => Navigator.pop(ctx),
              child: Text('إلغاء'),
            ),
            ElevatedButton(
              onPressed: () {
                if (selectedItem != null) {
                  double qty = double.tryParse(qtyController.text) ?? 1.0;
                  double price = double.tryParse(priceController.text) ?? 0.0;
                  setState(() {
                    _orderItems.add({
                      'item_code': selectedItem!['item_code']?.toString() ?? '',
                      'description': selectedItem!['description']?.toString() ?? '',
                      'unit': selectedItem!['unit']?.toString() ?? '',
                      'quantity': qty,
                      'unit_price': price,
                      'total': qty * price,
                    });
                  });
                  Navigator.pop(ctx);
                }
              },
              child: Text('إضافة'),
            ),
          ],
        ),
      ),
    );
  }

  void _saveOrder() async {
    if (_orderItems.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('الرجاء إضافة أصناف أولاً للطلب')),
      );
      return;
    }

    int orderNumber = int.tryParse(_orderNoController.text) ?? 1005;

    await DatabaseHelper.instance.insertOrder({
      'order_no': orderNumber,
      'order_date': DateFormat('yyyy-MM-dd').format(_selectedDate),
      'branch': _selectedBranch ?? '',
      'department': _selectedDepartment ?? '',
      'supplier': _selectedSupplier ?? '',
      'editor': _selectedEditor ?? '',
      'director': _selectedDirector ?? '',
      'status': 'مرحل',
    }, _orderItems);

    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text('تم ترحيل الطلب بنجاح رقم: $orderNumber')),
    );
    Navigator.pop(context, true);
  }

  @override
  Widget build(BuildContext context) {
    if (_isLoadingDefinitions) {
      return Scaffold(
        appBar: AppBar(title: Text('طلب شراء جديد')),
        body: Center(child: CircularProgressIndicator()),
      );
    }

    return Scaffold(
      appBar: AppBar(title: Text('طلب شراء جديد')),
      body: Directionality(
        textDirection: TextDirection.rtl,
        child: Padding(
          padding: EdgeInsets.all(12),
          child: Column(
            children: [
              Card(
                child: Padding(
                  padding: EdgeInsets.all(12),
                  child: Column(
                    children: [
                      Row(
                        children: [
                          Expanded(
                            child: TextField(
                              controller: _orderNoController,
                              decoration: InputDecoration(labelText: 'رقم الطلب'),
                              keyboardType: TextInputType.number,
                            ),
                          ),
                          SizedBox(width: 10),
                          Expanded(
                            child: Text(
                              "التاريخ: ${DateFormat('yyyy-MM-dd').format(_selectedDate)}",
                              style: TextStyle(fontWeight: FontWeight.bold),
                            ),
                          ),
                        ],
                      ),
                      Row(
                        children: [
                          Expanded(
                            child: DropdownButtonFormField<String>(
                              value: _selectedBranch,
                              decoration: InputDecoration(labelText: 'الفرع'),
                              items: _branches
                                  .map((b) => DropdownMenuItem(value: b, child: Text(b, overflow: TextOverflow.ellipsis)))
                                  .toList(),
                              onChanged: (v) => setState(() => _selectedBranch = v),
                            ),
                          ),
                          SizedBox(width: 10),
                          Expanded(
                            child: DropdownButtonFormField<String>(
                              value: _selectedSupplier,
                              decoration: InputDecoration(labelText: 'المورد'),
                              items: _suppliers
                                  .map((s) => DropdownMenuItem(value: s, child: Text(s, overflow: TextOverflow.ellipsis)))
                                  .toList(),
                              onChanged: (v) => setState(() => _selectedSupplier = v),
                            ),
                          ),
                        ],
                      ),
                      Row(
                        children: [
                          Expanded(
                            child: DropdownButtonFormField<String>(
                              value: _selectedDepartment,
                              decoration: InputDecoration(labelText: 'القسم / المستودع'),
                              items: _departments
                                  .map((d) => DropdownMenuItem(value: d, child: Text(d, overflow: TextOverflow.ellipsis)))
                                  .toList(),
                              onChanged: (v) => setState(() => _selectedDepartment = v),
                            ),
                          ),
                          SizedBox(width: 10),
                          Expanded(
                            child: DropdownButtonFormField<String>(
                              value: _selectedEditor,
                              decoration: InputDecoration(labelText: 'محرر الطلب'),
                              items: _editors
                                  .map((e) => DropdownMenuItem(value: e, child: Text(e, overflow: TextOverflow.ellipsis)))
                                  .toList(),
                              onChanged: (v) => setState(() => _selectedEditor = v),
                            ),
                          ),
                        ],
                      ),
                      Row(
                        children: [
                          Expanded(
                            child: DropdownButtonFormField<String>(
                              value: _selectedDirector,
                              decoration: InputDecoration(labelText: 'المدير المسؤول'),
                              items: _directors
                                  .map((m) => DropdownMenuItem(value: m, child: Text(m, overflow: TextOverflow.ellipsis)))
                                  .toList(),
                              onChanged: (v) => setState(() => _selectedDirector = v),
                            ),
                          ),
                        ],
                      ),
                    ],
                  ),
                ),
              ),
              SizedBox(height: 8),
              Expanded(
                child: _orderItems.isEmpty
                    ? Center(child: Text("لا توجد أصناف مضافة. اضغط 'إضافة صنف' للبدء"))
                    : ListView.separated(
                        itemCount: _orderItems.length,
                        separatorBuilder: (_, __) => Divider(height: 1),
                        itemBuilder: (ctx, idx) {
                          final item = _orderItems[idx];
                          return ListTile(
                            title: Text("${item['description']} (${item['item_code']})"),
                            subtitle: Text("الكمية: ${item['quantity']} ${item['unit']} × ${item['unit_price']}"),
                            trailing: Text("${item['total']} ر.س", style: TextStyle(fontWeight: FontWeight.bold)),
                          );
                        },
                      ),
              ),
              Container(
                padding: EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: Colors.blue.shade50,
                  borderRadius: BorderRadius.circular(8),
                ),
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.spaceBetween,
                  children: [
                    Text("الإجمالي: ${_totalAmount.toStringAsFixed(2)} ر.س",
                        style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold)),
                    Row(
                      children: [
                        OutlinedButton.icon(
                          icon: Icon(Icons.add),
                          label: Text('إضافة صنف'),
                          onPressed: _addItemDialog,
                        ),
                        SizedBox(width: 8),
                        ElevatedButton.icon(
                          icon: Icon(Icons.check),
                          label: Text('ترحيل'),
                          onPressed: _saveOrder,
                        ),
                      ],
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}